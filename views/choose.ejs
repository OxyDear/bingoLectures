<%- include('partials/head') %>
<h1><%= ev.title %></h1>
<% if (!picks.length) { %>
  <p class="muted">Администратор ещё не добавил пики. Загляните позже.</p>
<% } else { %>
<p class="muted">Отметьте пиков: <%= need %>. Выбирайте те, что, по-вашему, сбудутся. Очки указаны на каждом пике.</p>
<form method="post" action="/events/<%= ev.id %>/card">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="picks">
  <% picks.forEach(p => { %>
    <label class="pick">
      <input type="checkbox" name="picks" value="<%= p.id %>" <%= mine.has(p.id) ? 'checked' : '' %>>
      <span class="pts"><%= p.points %> очк.</span>
      <span class="t"><%= p.title %></span>
      <% if (p.category) { %><span class="tag"><%= p.category %></span><% } %>
    </label>
  <% }) %>
  </div>
  <div class="bar"><span id="cnt" aria-live="polite"></span><button class="btn" id="go">Сохранить карточку</button></div>
</form>
<script>
  const need = <%= need %>, boxes = [...document.querySelectorAll('input[name=picks]')];
  const cnt = document.getElementById('cnt'), go = document.getElementById('go');
  function upd() {
    const n = boxes.filter(b => b.checked).length;
    cnt.textContent = 'Выбрано ' + n + ' из ' + need;
    go.disabled = n !== need;
    boxes.forEach(b => { if (!b.checked) b.disabled = n >= need; });
  }
  boxes.forEach(b => b.addEventListener('change', upd)); upd();
</script>
<% } %>
<%- include('partials/foot') %>
