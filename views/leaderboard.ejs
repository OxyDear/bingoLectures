<%- include('partials/head') %>
<h1>Общий рейтинг</h1>
<p class="muted">Сумма очков по всем событиям. В зачёт идут только события, в которых администратор уже закрыл изменение карточек.</p>
<% if (!board.length) { %><p class="muted">Пока нет ни одного завершённого события.</p><% } else { %>
<ol class="board wide">
<% board.forEach((r) => { %>
  <li class="<%= user && r.id === user.id ? 'me' : '' %>">
    <span><%= r.rank %>. <%= r.username %> <small class="muted">· событий: <%= r.events %></small></span>
    <span class="num"><%= r.score %></span>
  </li>
<% }) %>
</ol>
<% } %>
<%- include('partials/foot') %>
