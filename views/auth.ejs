<%- include('partials/head') %>
<section class="auth">
  <h1><%= mode === 'login' ? 'Вход' : 'Регистрация' %></h1>
  <form method="post" action="/<%= mode %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Имя пользователя<input name="username" required maxlength="30" autocomplete="username"></label>
    <label>Пароль<input type="password" name="password" required <%= mode === 'register' ? 'minlength=8' : '' %> autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>"></label>
    <button class="btn"><%= mode === 'login' ? 'Войти' : 'Создать аккаунт' %></button>
  </form>
  <p class="muted"><% if (mode === 'login') { %>Нет аккаунта? <a href="/register">Зарегистрируйтесь</a><% } else { %>Уже есть аккаунт? <a href="/login">Войдите</a><% } %></p>
</section>
<%- include('partials/foot') %>
