<!doctype html>
<html lang="ru"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= locals.title ? locals.title + ' — ' : '' %>Синий флаг</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600&family=Unbounded:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/style.css">
</head><body>
<header class="top">
  <a class="logo" href="/">Синий флаг</a>
  <nav>
    <% if (user) { %>
      <a href="/events">События</a>
      <% if (user.role === 'admin') { %><a href="/admin">Админка</a><% } %>
      <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="link">Выйти (<%= user.username %>)</button></form>
    <% } else { %>
      <a href="/login">Войти</a><a href="/register">Регистрация</a>
    <% } %>
  </nav>
</header>
<main>
<% if (flash) { %><p class="flash <%= flash.type %>" role="status"><%= flash.text %></p><% } %>
